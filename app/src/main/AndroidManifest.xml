<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LifeOps and Citation contribute their own <uses-permission> entries via the manifest
         merger (they're library dependencies), so they are not repeated here. That includes
         INTERNET, which the updater below and the scheduled backup upload both rely on. -->

    <!-- Declared here as well as by the apps that post notifications, because this is where the
         permission is now *asked* for: it is granted to the package, and the container's home
         screen is the one screen every household passes through. See SandboxActivity. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The suite is sideloaded — built from a git tag by GitHub Actions and published as a
         release — so the container has to be able to install its own successor. This permission
         does not grant the install; it only makes the app *eligible* to ask, and the user still has
         to allow it per-app in Settings. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Lets an install session skip the confirmation screen when the sandbox installed the
         version being replaced — which it did, from the second self-update on. Normal protection:
         granted at install, and it grants nothing on its own. The Install button is still a tap;
         only the system dialog after it goes. See update/SelfInstaller. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- What SelfInstaller's setRequestUpdateOwnership needs: the sandbox becomes the app that
         updates itself, so a different installer replacing it has to say so first. Normal
         protection, granted at install. -->
    <uses-permission android:name="android.permission.ENFORCE_UPDATE_OWNERSHIP" />

    <application
        android:name=".SandboxApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sandbox">

        <!-- The one launcher entry point for the whole suite. -->
        <activity
            android:name=".SandboxActivity"
            android:exported="true"
            android:theme="@style/Theme.Sandbox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Where an install session reports back (see update/SelfInstaller). Not exported: the
             only sender is the platform installer, through a PendingIntent this app created. -->
        <receiver
            android:name=".update.InstallStatusReceiver"
            android:exported="false" />

    </application>

</manifest>

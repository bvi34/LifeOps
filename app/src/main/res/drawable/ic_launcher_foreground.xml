<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground — 108×108dp, visual content in the 72dp safe zone.
    Background colour comes from ic_launcher_background / colors.xml icon_bg.
    Coordinates are the ic_app_logo paths scaled by ≈0.763 and centred at (54,54).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Dial ring -->
    <path
        android:strokeColor="@color/icon_dial"
        android:strokeWidth="2"
        android:strokeAlpha="0.35"
        android:fillColor="#00000000"
        android:pathData="M54,25 A29,29 0 0 1 54,83 A29,29 0 0 1 54,25"/>

    <!-- 12 o'clock tick -->
    <path
        android:strokeColor="@color/icon_dial"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,25 L54,33"/>

    <!-- 3 o'clock tick -->
    <path
        android:strokeColor="@color/icon_dial"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M83,54 L75,54"/>

    <!-- 6 o'clock tick -->
    <path
        android:strokeColor="@color/icon_dial"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,83 L54,75"/>

    <!-- 9 o'clock tick -->
    <path
        android:strokeColor="@color/icon_dial"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M25,54 L33,54"/>

    <!-- Checkmark needle -->
    <path
        android:strokeColor="@color/icon_check"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M42,56 L50,64 L69,44"/>

</vector>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup and device-transfer rules for the container app.

  Deliberately word for word the same set as backup_rules.xml, in all three places: what a cloud
  restore is allowed to bring back, what a phone-to-phone transfer is allowed to carry, and what the
  older rules say are one policy, and a policy that disagrees with itself across two files is a bug
  waiting for the one restore nobody rehearsed. `AutoBackupRulesTest` asserts the three sections are
  identical rather than trusting this comment.

  Read backup_rules.xml for why the domains are taken whole, why `filesDir` is in neither list, and
  why every credential store is excluded; the reasoning is the same and is written down once.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />

        <exclude domain="sharedpref" path="oreilly_access.xml" />
        <exclude domain="sharedpref" path="opds_catalog_access.xml" />
        <exclude domain="sharedpref" path="secure_finance_access.xml" />
        <exclude domain="sharedpref" path="secure_secrets_device.xml" />
        <exclude domain="sharedpref" path="secure_utilities_seal_key.xml" />
        <exclude domain="sharedpref" path="secure_utilities_seal_key_plain.xml" />
        <exclude domain="sharedpref" path="sandbox_update_secrets.xml" />
        <exclude domain="sharedpref" path="sandbox_update_secrets_plain.xml" />
        <exclude domain="sharedpref" path="sandbox_cloud_backup_secrets.xml" />
        <exclude domain="sharedpref" path="sandbox_cloud_backup_secrets_plain.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />

        <!-- A transfer is phone-to-phone rather than through a transport, but the Keystore key
             still does not travel, so a restored credential store is just as unreadable here. -->
        <exclude domain="sharedpref" path="oreilly_access.xml" />
        <exclude domain="sharedpref" path="opds_catalog_access.xml" />
        <exclude domain="sharedpref" path="secure_finance_access.xml" />
        <exclude domain="sharedpref" path="secure_secrets_device.xml" />
        <exclude domain="sharedpref" path="secure_utilities_seal_key.xml" />
        <exclude domain="sharedpref" path="secure_utilities_seal_key_plain.xml" />
        <exclude domain="sharedpref" path="sandbox_update_secrets.xml" />
        <exclude domain="sharedpref" path="sandbox_update_secrets_plain.xml" />
        <exclude domain="sharedpref" path="sandbox_cloud_backup_secrets.xml" />
        <exclude domain="sharedpref" path="sandbox_cloud_backup_secrets_plain.xml" />
    </device-transfer>
</data-extraction-rules>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Ingestion sources (Royal Road scrape/feeds, O'Reilly read-in-place) touch the network.
         Owned content (EPUB/PDF) and all reading of cached content work fully offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The floating quick-capture bubble draws a chat-head over other apps. Opt-in and gated at
         runtime (Settings.canDrawOverlays); the bubble never appears until the user grants it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Citation is a library module now: no app-level attributes here (name/icon/theme/label live
         on the :app host). Only Citation's own components are declared for the merger. -->
    <application>

        <!-- No longer a launcher: the Operations Sandbox home opens this explicitly. The theme,
             previously inherited from the application, is set on the activity so the reader keeps
             its own look. The VIEW filter (open an EPUB or PDF from another app) stays. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Citation"
            android:windowSoftInputMode="adjustResize">

            <!-- Open a book file from another app (a file manager, a browser download, a share
                 sheet's "open with") straight into ingestion. Citation owns reading, so it is the
                 default for both of its owned formats: EPUB and PDF. `application/epub` is listed
                 alongside `application/epub+zip` because browsers and file managers commonly type
                 EPUBs with the shorter form. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/epub" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- Sanctioned capture entry points. A chromeless activity that receives text from another
             app, files it via the provenance ladder, and finishes — no app switch, no overlay. -->
        <activity
            android:name=".CaptureActivity"
            android:exported="true"
            android:theme="@style/Theme.Citation.Capture"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <!-- "Save to Citation" in the system text-selection toolbar (any app with selectable text). -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Share target: any app's share sheet can push a passage or link (incl. Kindle's
                 highlight-share and its notebook export) into Citation. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/html" />
            </intent-filter>
        </activity>

        <!-- The floating bubble's typed-note input. Launched by the bubble; never a launcher icon. -->
        <activity
            android:name=".ManualCaptureActivity"
            android:exported="false"
            android:theme="@style/Theme.Citation.ManualCapture"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <!-- The floating quick-capture bubble overlay service (started only once the overlay
             permission is granted). -->
        <service
            android:name=".QuickCaptureBubbleService"
            android:exported="false" />

        <!-- Shares exported Markdown notes as a real .md file via a content URI (see NotesExporter). -->
        <provider
            android:name=".CitationFileProvider"
            android:authorities="${applicationId}.citation.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/citation_file_paths" />
        </provider>
    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose supplies the real theme (see ui/theme). This is only the launch/base theme the
         Material3 Compose setup expects. -->
    <style name="Theme.Citation" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Chromeless theme for the capture entry points: they receive text, file it, toast, and
         finish, so they must never show visible chrome. It must be *translucent*, NOT
         windowNoDisplay: the activity files the capture asynchronously (awaits the repository) and
         finishes in that callback, but a windowNoDisplay activity is required to call finish() before
         onResume() completes — doing async work under it crashes with "did not call finish() prior to
         onResume() completing". A fully-transparent window shows nothing and lets the async work run. -->
    <style name="Theme.Citation.Capture" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Manual quick-capture (from the floating bubble): a translucent host for a small input
         dialog, so you type a note *over* whatever app you're in without a full screen switch. -->
    <style name="Theme.Citation.ManualCapture" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>

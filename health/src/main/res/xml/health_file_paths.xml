<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Where Health writes a file at the moment somebody asks to share it (cacheDir/exports): the
         insurance card PDF, or an on-request copy of a stored document. Deliberately only the export
         directory: the card photographs in filesDir/insurance-cards and the paperwork in
         filesDir/documents are records, not something any other app is invited to read. -->
    <cache-path name="exports" path="exports/" />
</paths>

<?xml version="1.0" encoding="utf-8"?>
<!--
    LifeOps in-app logo vector drawable.
    Colours reference res/values/colors.xml tokens (icon_bg / icon_dial / icon_check).
    Use in Compose via painterResource(R.drawable.ic_app_logo) or Image(painter=…).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Background rounded rect -->
    <path
        android:fillColor="@color/icon_bg"
        android:pathData="
            M24,0 L96,0
            A24,24 0 0 1 120,24
            L120,96
            A24,24 0 0 1 96,120
            L24,120
            A24,24 0 0 1 0,96
            L0,24
            A24,24 0 0 1 24,0 Z"/>

    <!-- Dial ring (full circle, two joined arcs) -->
    <path
        android:strokeColor="@color/icon_dial"
        android:strokeWidth="2.5"
        android:strokeAlpha="0.35"
        android:fillColor="#00000000"
        android:pathData="M60,22 A38,38 0 0 1 60,98 A38,38 0 0 1 60,22"/>

    <!-- 12 o'clock tick -->
    <path
        android:strokeColor="@color/icon_dial"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M60,22 L60,32"/>

    <!-- 3 o'clock tick -->
    <path
        android:strokeColor="@color/icon_dial"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M98,60 L88,60"/>

    <!-- 6 o'clock tick -->
    <path
        android:strokeColor="@color/icon_dial"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M60,98 L60,88"/>

    <!-- 9 o'clock tick -->
    <path
        android:strokeColor="@color/icon_dial"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M22,60 L32,60"/>

    <!-- Checkmark needle -->
    <path
        android:strokeColor="@color/icon_check"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M44,62 L56,73 L79,47"/>

</vector>

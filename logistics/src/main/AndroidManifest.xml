<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Recipe-from-link import fetches a page over HTTPS and parses its schema.org Recipe data.
         Everything else — the pantry, the Walmart PDF import, meal logging — works fully offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Logistics is a library module: no app-level attributes here (name/icon/theme/label live on
         the :app host). Only Logistics' own components are declared for the manifest merger. -->
    <application>

        <!-- Not a launcher: the Operations Sandbox home opens this explicitly. The theme is set on
             the activity so Logistics keeps its own launch look. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Logistics"
            android:windowSoftInputMode="adjustResize">

            <!-- Share a recipe link (or plain order text) from another app into Logistics, or share
                 a Walmart order PDF straight into the import flow. Note the action: *opening* a PDF
                 (ACTION_VIEW) belongs to Citation, which owns reading — a grocery order is the rare
                 PDF, a book the common one, so Logistics takes the deliberate "share to Logistics"
                 gesture rather than every PDF tap on the device.

                 Images are here for the same reason and land in the same place: a *screenshot* of a
                 recipe, shared from the gallery or straight out of the app you found it in, opens
                 the Recipes tab with the OCR already running on it. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- A recipe rarely fits on one screen, so several screenshots share as a batch. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

    </application>

</manifest>

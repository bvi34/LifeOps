<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Project requests no permissions. Everything it holds you typed into it, and none of it
         leaves the device: there is no cloud workspace to sync a document to, and no INTERNET
         permission to reach one with. -->

    <!-- Project is a library module: no app-level attributes here (name/icon/theme/label live on the
         :app host). Only Project's own components are declared for the manifest merger. -->
    <application>

        <!-- Not a launcher: the Operations Sandbox home opens this explicitly. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Project"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>

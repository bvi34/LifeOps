<?xml version="1.0" encoding="utf-8"?>
<!-- The autofill service's own declaration.

     Deliberately empty of a `settingsActivity`. That attribute names an activity the *system
     settings app* launches, which would mean exporting a second component — and the one thing
     worth keeping about this module's old "nothing is exported" promise is that the list of
     exceptions stays short enough to read. Everything configurable is in Secrets' own settings
     screen, one tap from the home screen. -->
<autofill-service xmlns:android="http://schemas.android.com/apk/res/android" />

<?xml version="1.0" encoding="utf-8"?>
<!-- What Secrets offers Credential Manager.

     Public-key credentials only. Passwords are not declared here even though the vault is full of
     them, because they already reach other apps through the autofill service — declaring the type
     twice would put Secrets in two different system pickers for the same job and make "where does
     my password come from" a question with two answers. -->
<credential-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsSubtitle="@string/secrets_passkey_settings_subtitle">
    <capabilities>
        <capability name="androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
    </capabilities>
</credential-provider>
